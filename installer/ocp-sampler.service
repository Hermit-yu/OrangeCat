[Unit]
Description=OrangeCatPanel metrics sampler (history recorder).
Requires=ocp-agent.service
After=ocp-agent.service

[Service]
Type=simple
User=ocp-panel
Group=ocp-panel
SupplementaryGroups=ocp-agent
StateDirectory=ocp
ExecStart=/opt/OrangeCatPanel/bin/ocp-sampler -socket /run/ocp/agent.sock -db /var/lib/ocp/metrics.db -interval 30
Restart=on-failure
RestartSec=5
# read-only host access: no capabilities beyond default
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target